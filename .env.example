# Local development only. Never commit a real .env file.
NODE_ENV=development
PORT=3000

# PostgreSQL can be omitted only in local development; data is ephemeral without it.
DATABASE_URL=

# Cloudflare R2 S3-compatible API. All values are required in production.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hendy-server-app-artifacts

# Set these in Render as secrets. There are no built-in admin credentials.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_DISPLAY_NAME=Hendy Administrator

# Multipart upload stays small to protect Render Free memory.
# Use the direct R2 upload endpoint for larger binaries.
MAX_UPLOAD_BYTES=52428800
PG_POOL_MAX=5

# Optional domain metadata shown in the admin panel.
ADMIN_DOMAIN=
PUBLIC_DOWNLOAD_DOMAIN=
