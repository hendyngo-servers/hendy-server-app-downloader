# Local Cloudflare Workers/Pages development only.
# Copy to .dev.vars for Wrangler local development; NEVER commit .dev.vars.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_DISPLAY_NAME=Hendy Administrator
MAX_UPLOAD_BYTES=52428800

# Optional local host-routing bootstrap (hostnames only; no https:// or path).
ADMIN_DOMAIN=admin.example.com
PUBLIC_DOWNLOAD_DOMAIN=downloads.example.com
SHARED_API_DOMAIN=api.example.com
